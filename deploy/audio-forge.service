[Unit]
Description=audio-forge 音频转换服务
Documentation=https://github.com/Garvin666/audio-forge
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=audioforge
Group=audioforge
WorkingDirectory=/opt/audio-forge

# 口令与令牌放这里，别写进命令行（ps 能看到）
EnvironmentFile=/etc/audio-forge/env

# 必须关掉 stdout 缓冲：systemd 下 stdout 是管道，Python 默认块缓冲，
# 结果 journalctl -u audio-forge 里**一行应用输出都没有**（连启动横幅都收不到），
# 排查时会以为服务没起来。Docker 路径没这问题是因为 Dockerfile 里设了同一个变量。
Environment=PYTHONUNBUFFERED=1

# 只监听回环，公网流量由 Nginx 转发进来
ExecStart=/opt/audio-forge/venv/bin/audioforge serve \
    --host 127.0.0.1 \
    --port 8000 \
    --workdir /var/lib/audio-forge \
    --max-mb 200 \
    --ttl 3600 \
    --rate 120 \
    --daily-files 2000 \
    --daily-gb 20 \
    --disk-gb 20 \
    --quiet

Restart=on-failure
RestartSec=3

# --- 加固 ---
# 版本前提：本单元用到 RestrictSUIDSGID=（242）、ProtectProc=（247）、
# ProtectClock=（245）、ProtectKernelLogs=（244）、ProtectHostname=（242）。
# 因此 systemd ≥ 247 才完整体检通过；242–246 会被 systemd 忽略未知项（只告警）；
# < 242 请改用 deploy/audio-forge.service.rhel7，并在目标机上跑
#   systemd-analyze verify deploy/audio-forge.service
# 判据是**零输出**——`systemd-analyze verify` 对语法错误也返回 0，只看退出码会假绿。
NoNewPrivileges=yes
PrivateTmp=yes
PrivateDevices=yes
ProtectSystem=strict
ProtectHome=yes
ProtectKernelTunables=yes
ProtectKernelModules=yes
ProtectKernelLogs=yes
ProtectControlGroups=yes
ProtectClock=yes
ProtectHostname=yes
ProtectProc=invisible
RestrictSUIDSGID=yes
RestrictNamespaces=yes
RestrictRealtime=yes
LockPersonality=yes
MemoryMax=2G
TasksMax=128
UMask=0077

# 这个服务不需要任何 capability：端口 8000 在非特权区间，文件由 User= 自己的身份读写
CapabilityBoundingSet=
AmbientCapabilities=

# 只用到 TCP/UDP(监听回环) 与 AF_UNIX；不给 AF_NETLINK / AF_PACKET 留口子
RestrictAddressFamilies=AF_INET AF_INET6 AF_UNIX
SystemCallArchitectures=native

# 只放行 systemd 预置的「普通服务」白名单（212 起可用）。
# 注意 syscall 过滤比路径更狠：写错会让服务启动即 EPERM，改完务必本机跑一遍。
SystemCallFilter=@system-service
SystemCallErrorNumber=EPERM

# 只有结果目录可写（PrivateTmp 会重定向 /tmp，但 --workdir 显式指到了 /var/lib）
ReadWritePaths=/var/lib/audio-forge

[Install]
WantedBy=multi-user.target
